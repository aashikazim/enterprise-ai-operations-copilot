# Copy to backend/.env; substitute your local credentials. Never commit .env.
DATABASE_URL=postgresql+psycopg://copilot:CHANGE_ME@localhost:5432/copilot_db
JWT_SECRET_KEY=REPLACE_WITH_A_LOCALLY_GENERATED_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Evaluation is opt-in and may incur additional provider costs when the worker runs.
RAG_EVAL_ENABLED=false
RAG_EVAL_SAMPLE_RATE=0.0
# Optional dedicated operator scrape token; empty disables /metrics.
MONITORING_METRICS_TOKEN=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
