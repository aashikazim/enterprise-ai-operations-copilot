# Local Compose secrets: generate independent random values; never commit .env.
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_SECRET
JWT_SECRET_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
# Loopback recommended. Original base Compose LAN binding remains configurable.
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
DB_PORT=5432
FRONTEND_PORT=8080
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
RAG_EVAL_ENABLED=false
RAG_EVAL_SAMPLE_RATE=0.0
EVALUATION_WORKER_CONCURRENCY=1
